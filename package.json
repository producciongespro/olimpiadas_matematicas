{
  "name": "olimpiadas-matematicas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/public-web",
    "apps/admin-web",
    "packages/*"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace=@olcomep/public-web",
    "dev:admin": "npm run dev --workspace=@olcomep/admin-web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "swagger-ui-dist": "5.17.14"
  }
}
