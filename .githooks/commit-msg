#!/bin/sh

commit_message_file="$1"
first_line="$(sed -n '1p' "$commit_message_file")"
expected_date="$(date +%d-%m-%Y)"

case "$first_line" in
  "$expected_date "?*)
    exit 0
    ;;
  *)
    echo "ERROR: el mensaje debe iniciar con la fecha actual y una descripción amplia." >&2
    echo "Formato obligatorio: $expected_date Descripción amplia en español" >&2
    echo "No se permiten prefijos como feat:, fix: o docs: antes de la fecha." >&2
    exit 1
    ;;
esac
